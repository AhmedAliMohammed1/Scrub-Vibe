NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional legacy/common alias; configure either this or SUPABASE_SECRET_KEY, never expose it publicly.
SUPABASE_SERVICE_ROLE_KEY=
# Keep false until Paymob sandbox acceptance and webhook verification pass.
PAYMOB_ENABLED=false
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=
NEXT_PUBLIC_INSTAPAY_ADDRESS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_RATE_LIMIT_SALT=
# Set to false to allow checkout without phone OTP. Defaults to true.
CHECKOUT_PHONE_OTP_ENABLED=true
# Local development only; never set in Production.
CHECKOUT_TEST_OTP=
RESEND_API_KEY=
# Email address used in the From: header. Use your verified Resend domain (defaults to onboarding@resend.dev for testing).
RESEND_FROM_EMAIL=noreply@yourstore.com
# Staff alert destination — receives new-order and proof-submitted notifications.
STAFF_EMAIL=ops@yourstore.com
CRON_SECRET=
CART_RECOVERY_ENABLED=true
CART_RECOVERY_FIRST_DELAY_HOURS=2
CART_RECOVERY_SECOND_DELAY_HOURS=24
CART_RECOVERY_DISCOUNT_DELAY_HOURS=48
CART_RECOVERY_DISCOUNT_PERCENT=10
CART_RECOVERY_DISCOUNT_EXPIRY_HOURS=72
CART_RECOVERY_BATCH_SIZE=20
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v24.0
# Reserved for remaining production observability and distributed rate limiting.
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
